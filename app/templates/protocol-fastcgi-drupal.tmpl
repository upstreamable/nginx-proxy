{{ define "protocol-fastcgi-drupal" }}
# Named location can not be nested inside a location.
location @drupal-{{ trim .Upstream }} {
    include fastcgi.conf;
    {{ if env "FASTCGI_SEND_TIMEOUT" }}
    fastcgi_send_timeout {{ env "FASTCGI_SEND_TIMEOUT" }};
    {{ end }}
    {{ if env "FASTCGI_READ_TIMEOUT" }}
    fastcgi_read_timeout {{ env "FASTCGI_READ_TIMEOUT" }};
    {{ end }}
    fastcgi_param QUERY_STRING $query_string;
    fastcgi_param SCRIPT_NAME /index.php;
    fastcgi_param SCRIPT_FILENAME $document_root/index.php;
    root   {{ trim .VhostRoot }};
    fastcgi_pass {{ trim .Upstream }};
}

location @drupal-no-args-{{ trim .Upstream }} {
    include fastcgi.conf;
    fastcgi_param QUERY_STRING q=$uri;
    fastcgi_param SCRIPT_NAME /index.php;
    fastcgi_param SCRIPT_FILENAME $document_root/index.php;
    root   {{ trim .VhostRoot }};
    fastcgi_pass {{ trim .Upstream }};
}

location {{ .Path }} {
    # Copied from original location template. See `define "location"` in nginx.tmpl.
    {{ if eq .NetworkTag "internal" }}
    # Only allow traffic from internal clients
    include /etc/nginx/network_internal.conf;
    {{ end }}
    {{ if (exists (printf "/etc/nginx/htpasswd/%s" .Host)) }}
    auth_basic	"Restricted {{ .Host }}";
    auth_basic_user_file	{{ (printf "/etc/nginx/htpasswd/%s" .Host) }};
    {{ end }}

    {{ if (exists (printf "/etc/nginx/vhost.d/%s_%s_location" .Host (sha1 .Path) )) }}
    include {{ printf "/etc/nginx/vhost.d/%s_%s_location" .Host (sha1 .Path) }};
    {{ else if (exists (printf "/etc/nginx/vhost.d/%s_location" .Host)) }}
    include {{ printf "/etc/nginx/vhost.d/%s_location" .Host}};
    {{ else if (exists "/etc/nginx/vhost.d/default_location") }}
    include /etc/nginx/vhost.d/default_location;
    {{ end }}

    # Root for all static files.
    root /mnt/assets/webroot_{{ .Host }};

    # Taken from https://github.com/wodby/nginx/blob/master/templates/presets/drupal9.conf.tmpl on 8/May/2022.
    # Replaced getenv for $.env.VARIABLE statements or defaults.
    # Append Upstream name to named locations @drupal and @drupal-no-args.
    # Moved named location outside the main location.
    # Replaced `fastcgi_pass php` for:
    # root   {{ trim .VhostRoot }};
    # fastcgi_pass {{ trim .Upstream }};
    # Allow for bigger uploads: 4G.
    client_max_body_size 4000M;

    {{ $static := "css|cur|js|jpe?g|gif|htc|ico|png|xml|otf|ttf|eot|woff|woff2|svg|mp4|svgz|ogg|ogv|pdf|pptx?|zip|tgz|gz|rar|bz2|doc|xls|exe|tar|mid|midi|wav|bmp|rtf|txt|map|webp" }}
    {{ $not_found_regex := "\\.(engine|txt|inc|install|make|module|profile|po|sh|.*sql|theme|twig|tpl(\\.php)?|xtmpl|yml)(~|\\.sw[op]|\\.bak|\\.orig|\\.save)?$|^(\\.(?!well-known).*|Entries.*|Repository|Root|Tag|Template|composer\\.(json|lock)|(package|package-lock)\\.json|yarn\\.lock|web\\.config)$|^#.*#$|\\.php(~|\\.sw[op]|\\.bak|\\.orig|\\.save)$" }}

    index index.php index.html;

    include fastcgi.conf;

    fastcgi_hide_header 'X-Drupal-Cache';
    fastcgi_hide_header 'X-Generator';
    fastcgi_hide_header 'X-Drupal-Dynamic-Cache';

    location / {
        location ~* /system/files/ {
            include fastcgi.conf;
            fastcgi_param QUERY_STRING $query_string;
            fastcgi_param SCRIPT_NAME /index.php;
            fastcgi_param SCRIPT_FILENAME $document_root/index.php;
            root   {{ trim .VhostRoot }};
            fastcgi_pass {{ trim .Upstream }};
            log_not_found off;
        }

        location ~* /sites/.+/files/private/ {
            internal;
        }

        location ~* /files/(css|js|styles)/ {
            access_log {{ "off" }};
            expires {{ "1y" }};
            try_files $uri @drupal-{{ trim .Upstream }};
        }

        location ~* /sites/.+/files/.+\.txt {
            access_log {{ "off" }};
            expires {{ "1y" }};
            tcp_nodelay {{ "off" }};
            open_file_cache max=1000 inactive=30s;
            open_file_cache_valid 30s;
            open_file_cache_min_uses 2;
            open_file_cache_errors off;
        }

        location ~* /sites/.+/files/advagg_css/ {
            expires max;
            add_header ETag '';
            add_header Last-Modified 'Wed, 20 Jan 1988 04:20:42 GMT';
            add_header Accept-Ranges '';
            location ~* /sites/.*/files/advagg_css/.+\.css$ {
                access_log {{ "off" }};
                add_header Cache-Control "public, max-age=31536000, no-transform, immutable";
                try_files $uri @drupal-{{ trim .Upstream }};
            }
        }

        location ~* /sites/.+/files/advagg_js/ {
            expires max;
            add_header ETag '';
            add_header Last-Modified 'Wed, 20 Jan 1988 04:20:42 GMT';
            add_header Accept-Ranges '';
            location ~* /sites/.*/files/advagg_js/.+\.js$ {
                access_log {{ "off" }};
                add_header Cache-Control "public, max-age=31536000, no-transform, immutable";
                try_files $uri @drupal-{{ trim .Upstream }};
            }
        }

        location ~* /admin/reports/hacked/.+/diff/ {
            try_files $uri @drupal-{{ trim .Upstream }};
        }
        location ~* /rss.xml {
            try_files $uri @drupal-no-args-{{ trim .Upstream }};
        }

        location ~* /sitemap.xml {
            try_files $uri @drupal-{{ trim .Upstream }};
        }

# Replica of regex from Drupals core .htaccess.
        location ~* {{ $not_found_regex }} {
            return 404;
        }

        location ~* ^.+\.(?:{{ $static }})$ {
            access_log {{ "off" }};
            tcp_nodelay {{ "off" }};
            expires {{ "1y" }};

            add_header Pragma "cache";
            add_header Cache-Control "public";

            open_file_cache max=1000 inactive=30s;
            open_file_cache_valid 30s;
            open_file_cache_min_uses 2;
            open_file_cache_errors off;
        }

        try_files $uri @drupal-{{ trim .Upstream }};
    }

    location = /index.php {
        root   {{ trim .VhostRoot }};
        fastcgi_pass {{ trim .Upstream }};
    }

    location = /core/install.php {
        root   {{ trim .VhostRoot }};
        fastcgi_pass {{ trim .Upstream }};
    }

    location = /core/rebuild.php {
        root   {{ trim .VhostRoot }};
        fastcgi_pass {{ trim .Upstream }};
    }

    location ~* ^/core/authorize.php {
        include fastcgi.conf;
        fastcgi_param QUERY_STRING $args;
        fastcgi_param SCRIPT_NAME /core/authorize.php;
        fastcgi_param SCRIPT_FILENAME $document_root/core/authorize.php;
        root   {{ trim .VhostRoot }};
        fastcgi_pass {{ trim .Upstream }};
    }

    location = /core/modules/statistics/statistics.php {
        root   {{ trim .VhostRoot }};
        fastcgi_pass {{ trim .Upstream }};
    }

    location = /cron {
        include fastcgi.conf;
        fastcgi_param QUERY_STRING $args;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        root   {{ trim .VhostRoot }};
        fastcgi_pass {{ trim .Upstream }};
    }

    location ~* ^/update.php {
        include fastcgi.conf;
        fastcgi_param QUERY_STRING $args;
        fastcgi_param SCRIPT_NAME /update.php;
        fastcgi_param SCRIPT_FILENAME $document_root/update.php;
        root   {{ trim .VhostRoot }};
        fastcgi_pass {{ trim .Upstream }};
    }

    location ^~ /patches {
        return 404;
    }

    location ^~ /backup {
        return 404;
    }

    location ~* ^.+\.php$ {
        return 404;
    }
}
{{ end }}
